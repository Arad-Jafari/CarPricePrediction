# Set DATABASE_URL or the POSTGRES_* values below (for example POSTGRES_HOST=db in Compose).
DATABASE_URL=postgresql+psycopg://postgres:replace-me@db:5432/car_estimation
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=car_estimation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secret
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
JWT_ALGORITHM=HS256
# Defaults resolve to ml/artifacts/CarPredictionModel.pkl and ml/artifacts/CarPreprocessor.pkl.
MODEL_PATH=ml/artifacts/CarPredictionModel.pkl
PREPROCESSOR_PATH=ml/artifacts/CarPreprocessor.pkl
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Local Ollama settings. Change OLLAMA_CHAT_MODEL to any installed compatible model.
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3:1b
AI_CONTEXT_WINDOW=2048
AI_MAX_HISTORY_MESSAGES=8
AI_TEMPERATURE=0.3
AI_ENABLE_RAG=false
AI_ENABLE_TOOLS=true
AI_STORAGE_PATH=../local_data
AI_VECTOR_DB_PATH=../local_data/chroma
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSION=768
# Optional dotted custom provider; takes precedence over Ollama when set.
CHAT_PROVIDER=
