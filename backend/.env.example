# Set DATABASE_URL or the POSTGRES_* values below (for example POSTGRES_HOST=db in Compose).
DATABASE_URL=postgresql+psycopg://postgres:replace-me@db:5432/car_estimation
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=car_estimation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secret
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
JWT_ALGORITHM=HS256
# Defaults resolve to ml/artifacts/CarPredictionModel.pkl and ml/artifacts/CarPreprocessor.pkl.
MODEL_PATH=ml/artifacts/CarPredictionModel.pkl
PREPROCESSOR_PATH=ml/artifacts/CarPreprocessor.pkl
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional dotted class path to an explicitly configured real provider implementing generate_reply(messages).
CHAT_PROVIDER=
