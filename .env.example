# Local development defaults only. Change all credentials before deployment.
ENVIRONMENT=development
APP_PORT=3000
API_PORT=8000

POSTGRES_DB=carprice
POSTGRES_USER=carprice
POSTGRES_PASSWORD=local-development-only-change-before-deployment
POSTGRES_PORT=5432

JWT_SECRET_KEY=local-development-only-change-before-deployment
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000

# Leave empty to keep conversations as user notes without an AI response.
CHAT_PROVIDER=
