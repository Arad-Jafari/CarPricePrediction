# Local development defaults only. Change all credentials before deployment.
ENVIRONMENT=development
APP_PORT=3000
API_PORT=8000

POSTGRES_DB=carprice
POSTGRES_USER=carprice
POSTGRES_PASSWORD=local-development-only-change-before-deployment
POSTGRES_PORT=5432

JWT_SECRET_KEY=local-development-only-change-before-deployment
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000

# Local AI configuration. Model names must exist in the selected Ollama service.
AI_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=gemma3:1b
AI_CONTEXT_WINDOW=2048
AI_MAX_HISTORY_MESSAGES=8
AI_TEMPERATURE=0.3
AI_ENABLE_RAG=false
AI_ENABLE_TOOLS=true
AI_STORAGE_PATH=./local_data
AI_VECTOR_DB_PATH=./local_data/chroma
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSION=768

# Optional custom Python provider; leave empty to use Ollama when AI_ENABLED=true.
CHAT_PROVIDER=
